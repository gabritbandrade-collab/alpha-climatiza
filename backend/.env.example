# Copie este arquivo para ".env" e ajuste os valores.
#
# Em produção (Railway), estas variáveis são configuradas no painel do
# serviço, não em um arquivo .env commitado no repositório.

# Local: arquivo SQLite dentro da pasta do backend.
# Produção: caminho dentro do volume persistente, ex: file:/data/prod.db
DATABASE_URL="file:./dev.db"

# Gere um valor aleatório forte para produção, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-valor-em-producao"

PORT=3333

# Local: pasta relativa "./uploads".
# Produção: caminho dentro do volume persistente, ex: /data/uploads
UPLOADS_DIR="./uploads"

# Opcional: lista de origens (separadas por vírgula) autorizadas a chamar a
# API. Deixe em branco para permitir qualquer origem (padrão).
# CORS_ORIGIN="https://seuapp.up.railway.app"

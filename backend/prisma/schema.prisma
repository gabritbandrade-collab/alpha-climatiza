generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma; these are plain strings
// validated in the application layer:
// Role: "ADMIN" | "EMPLOYEE"
// UserStatus: "ACTIVE" | "INACTIVE"
// ServiceStatus: "SCHEDULED" | "IN_PROGRESS" | "COMPLETED" | "PENDING" | "CANCELLED"
// PhotoType: "BEFORE" | "AFTER"
// Priority: "LOW" | "NORMAL" | "HIGH" | "URGENT"
// ServiceRequestStatus: "PENDING" | "ASSIGNED" | "CANCELLED"

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  phone        String?
  cargo        String?
  photoUrl     String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  servicesAsEmployee Service[]      @relation("EmployeeServices")
  notifications      Notification[]
  historyEntries     ServiceHistory[]
  serviceRegions     EmployeeCity[]

  @@map("users")
}

/// Cidades/regiões que um funcionário atende ("Região de atendimento").
model EmployeeCity {
  id         String   @id @default(cuid())
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  city       String
  state      String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, city])
  @@map("employee_cities")
}

/// Pedido de serviço feito por um cliente, antes de ser distribuído/atribuído
/// a um funcionário responsável pela região. Ao ser atribuído, gera um
/// registro em Service (reaproveitando toda a execução: fotos, materiais,
/// observações, etc.).
model ServiceRequest {
  id          String   @id @default(cuid())
  clientName  String
  phone       String?
  address     String
  city        String
  state       String?
  serviceType String
  description String?
  desiredAt   DateTime
  notes       String?
  materialsPlan String?
  priority    String   @default("NORMAL")
  status      String   @default("PENDING")

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  resultingServiceId String?  @unique
  resultingService   Service? @relation(fields: [resultingServiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_requests")
}

model Client {
  id           String   @id @default(cuid())
  name         String
  document     String?
  phone        String?
  email        String?
  address      String?
  number       String?
  complement   String?
  city         String?
  state        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  services Service[]
  requests ServiceRequest[]

  @@map("clients")
}

model Service {
  id            String        @id @default(cuid())
  serviceType   String
  description   String?
  notes         String?
  materialsPlan String?
  address       String
  city          String?
  state         String?
  priority      String @default("NORMAL")
  scheduledAt   DateTime
  status        String @default("SCHEDULED")

  startedAt     DateTime?
  completedAt   DateTime?

  employeeObservations String?
  problems             String?
  pendingNotes         String?

  clientId   String
  client     Client @relation(fields: [clientId], references: [id])

  employeeId String
  employee   User   @relation("EmployeeServices", fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos    ServicePhoto[]
  materials ServiceMaterial[]
  history   ServiceHistory[]
  notifications Notification[]
  originRequest ServiceRequest?

  @@map("services")
}

model ServicePhoto {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type      String
  url       String
  createdAt DateTime @default(now())

  @@map("service_photos")
}

model ServiceMaterial {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name      String
  quantity  String
  notes     String?
  createdAt DateTime @default(now())

  @@map("service_materials")
}

model ServiceHistory {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  @@map("service_history")
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  title           String
  message         String
  read            Boolean  @default(false)
  relatedServiceId String?
  relatedService  Service? @relation(fields: [relatedServiceId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@map("notifications")
}
